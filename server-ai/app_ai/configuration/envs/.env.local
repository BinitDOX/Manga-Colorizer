# ── Core app settings ───────────────────────────────────────────────
ENVIRONMENT          = local
PROJECT_NAME         = "Manga Colorizer"
CORS_ORIGINS         = *
LOG_LEVEL            = DEBUG     # Set to DEBUG for local development

# ── Device & model paths ────────────────────────────────────────────
DEVICE               = cuda
COLORIZER_PATH       = app_ai/ai/networks/generator.zip
UPSCALER_PATH        = app_ai/ai/networks/RealESRGAN_x4plus_anime_6B.pt
EXTRACTOR_PATH       = app_ai/ai/networks/extractor.pth
# DENOISER_PATH      =

# ── Feature flags ───────────────────────────────────────────────────
COLORIZE_ENABLED     = true
UPSCALE_ENABLED      = true
DENOISE_ENABLED      = true
UPSCALER_TYPE        = ESRGAN
UPSCALE_FACTOR       = 4
DENOISE_SIGMA        = 25
